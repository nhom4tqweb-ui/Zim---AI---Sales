# Server
PORT=3000
HOST=0.0.0.0

# Voucher: ZIM chưa công bố mức giảm lệ phí thi cụ thể nên để trống (modal không hiện số tiền).
# Chỉ điền khi nhóm có số liệu chính thức.
DEMO_VOUCHER_AMOUNT=
DEMO_VOUCHER_DAYS=30

# Optional: bật lớp LLM chỉ để làm tự nhiên câu chữ.
# Business rules vẫn do state machine kiểm soát.
ENABLE_LLM_NATURALIZATION=false
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=