# ============================================================================
# Bien moi truong cua BE2 (Leads & CRM)
# Copy file nay thanh `.env` roi dien gia tri that. KHONG commit file `.env`.
# ============================================================================

# Cong chay service
PORT=5060

# --- DATABASE ---
# De TRONG ca 2 dong duoi => dung file SQLite local (data/leads.db), chay duoc
# ngay khong can cai dat gi them.
# Dien vao => dung Turso (SQLite tren cloud), phuc vu deploy serverless.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Duong dan file SQLite local (tuy chon, mac dinh: data/leads.db)
DB_FILE=

# --- TAI KHOAN ADMIN ---
# Dung de lay token goi GET /api/leads. DOI NGAY khi chay that.
ADMIN_EMAIL=admin@zimacademy.vn
ADMIN_PASSWORD=Admin@123
