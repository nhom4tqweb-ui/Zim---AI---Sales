# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
MONGO_URI=mongodb://localhost:27017/zim_academy

# --- Order / QR settings ---
ORDER_EXPIRE_MINUTES=15
BANK_ID=970422          # BIN của ngân hàng, vd MB Bank = 970422
BANK_ACCOUNT_NO=0123456789
BANK_ACCOUNT_NAME=ZIM ACADEMY
VIETQR_TEMPLATE=compact2

# --- Payment webhook security (SePay / Casso / bank gateway) ---
# Cách 1: API Key - cổng gửi header "Authorization: Apikey <value>"
WEBHOOK_API_KEY=your_webhook_api_key_here
# Cách 2 (khuyến nghị nếu cổng hỗ trợ): HMAC-SHA256 - cổng ký request bằng secret này
WEBHOOK_HMAC_SECRET=your_hmac_secret_here
WEBHOOK_SIGNATURE_HEADER=x-signature
# Cho phép sai lệch số tiền (đồng) khi đối soát, vd phí ngân hàng làm tròn
AMOUNT_TOLERANCE=0

# --- Bank/gateway query API (dùng cho cronjob đối soát backup) ---
BANK_GATEWAY_BASE_URL=https://my.sepay.vn/userapi
BANK_GATEWAY_API_TOKEN=your_gateway_read_api_token

# --- Web Push (VAPID) ---
# Tạo bằng: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@zimacademy.vn
